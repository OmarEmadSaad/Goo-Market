# ---------------------------------------------------------------------------
# Firebase Realtime Database
# ---------------------------------------------------------------------------
# Preferred: server-only, never reaches the browser.
FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com
#
# Legacy fallbacks, still supported so an existing deployment keeps working.
# lib/server/db.ts resolves the root in this order:
#   1. FIREBASE_DB_URL
#   2. NEXT_PUBLIC_BASE_URL
#   3. NEXT_PUBLIC_FIREBASE_DATABASE_URL
#   4. NEXT_PUBLIC_PRODUCT_URL   (root derived by stripping "/products.json")
#   5. NEXT_PUBLIC_USERS_URL     (root derived by stripping "/users.json")
# They are read only inside a `server-only` module, so they are not inlined
# into the client bundle even though they carry a NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_BASE_URL=https://your-project-default-rtdb.firebaseio.com
# NEXT_PUBLIC_PRODUCT_URL=https://your-project-default-rtdb.firebaseio.com/products.json
# NEXT_PUBLIC_USERS_URL=https://your-project-default-rtdb.firebaseio.com/users.json

# Optional database secret / ID token, appended as ?auth= so the database
# rules can be locked down to deny public access. See SECURITY.md.
FIREBASE_DB_AUTH=

# ---------------------------------------------------------------------------
# Session signing (server-only, required)
# ---------------------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Login and registration throw without this. Rotating it ends all sessions.
AUTH_SECRET=replace-me-with-32-random-bytes-hex

# ---------------------------------------------------------------------------
# Public (safe in the browser)
# ---------------------------------------------------------------------------
# Must be the real production origin: it is baked into canonical URLs,
# Open Graph tags, sitemap.xml and JSON-LD at build time.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Cloudinary unsigned upload preset - public by design.
NEXT_PUBLIC_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_UPLOAD_PRESET=your-unsigned-preset
