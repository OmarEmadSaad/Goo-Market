# ---------------------------------------------------------------------------
# Server-only (never exposed to the browser)
# ---------------------------------------------------------------------------
# Firebase Realtime Database root. All reads/writes go through the server.
FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com
# Optional Firebase database secret / ID token, appended as ?auth= so the
# database rules can be locked down to deny public access. See SECURITY.md.
FIREBASE_DB_AUTH=
# HMAC key used to sign the session cookie. Rotate to invalidate all sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me-with-32-random-bytes-hex

# ---------------------------------------------------------------------------
# Public (safe to ship to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://goomarket.vercel.app
# Cloudinary unsigned upload preset - public by design.
NEXT_PUBLIC_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_UPLOAD_PRESET=your-unsigned-preset
